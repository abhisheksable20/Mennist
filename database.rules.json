{
  "rules": {
    "posts": {
      ".read": true,
      ".write": false,
      ".indexOn": [
        "timestamp",
        "category"
      ]
    },
    "userPosts": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "coins": {
      ".indexOn": [
        "streak/lastDay"
      ]
    },
    "coinLedger": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "pendingTransfers": {
      ".indexOn": [
        ".value"
      ]
    },
    "pendingChatStarts": {
      ".indexOn": [
        "at"
      ]
    },
    "pendingRematches": {
      ".indexOn": [
        "at"
      ]
    },
    "users": {
      "$uid": {
        "notification": {
          ".indexOn": [
            "timestamp"
          ]
        },
        "posts": {
          ".indexOn": [
            "timestamp"
          ]
        }
      }
    },
    "coinChat": {
      "$uid": {
        "$other": {
          ".indexOn": [
            "createdAt"
          ]
        }
      }
    }
  }
}
