{
  "rules": {
    "posts": {
      ".read": true,
      ".write": false,
      ".indexOn": [
        "timestamp"
      ]
    },
    "userPosts": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "coins": {
      ".indexOn": [
        "streak/lastDay"
      ]
    },
    "coinLedger": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "pendingTransfers": {
      ".indexOn": [
        ".value"
      ]
    }
  }
}
