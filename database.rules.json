{
  "rules": {
    ".read": false,
    ".write": false,
    "posts": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "timestamp",
        "category"
      ]
    },
    "userPosts": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "coins": {
      ".indexOn": [
        "streak/lastDay"
      ]
    },
    "coinLedger": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "invites": {
      "$uid": {
        "friends": {
          ".indexOn": [
            "joinedAt"
          ]
        }
      }
    },
    "pendingTransfers": {
      ".indexOn": [
        ".value"
      ]
    },
    "sessions": {
      ".indexOn": [
        "userId"
      ]
    },
    "loginChallenges": {
      ".indexOn": [
        "expiresAt"
      ]
    },
    "pendingChatStarts": {
      ".indexOn": [
        "at"
      ]
    },
    "pendingRematches": {
      ".indexOn": [
        "at"
      ]
    },
    "users": {
      "$uid": {
        "notification": {
          ".indexOn": [
            "timestamp"
          ]
        },
        "posts": {
          ".indexOn": [
            "timestamp"
          ]
        }
      }
    },
    "coinChat": {
      "$uid": {
        "$other": {
          ".indexOn": [
            "createdAt"
          ]
        }
      }
    },
    "echoes": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "echoFeed": {
      ".indexOn": [
        "timestamp"
      ]
    },
    "attachmentIndex": {
      ".indexOn": [
        "at"
      ]
    },
    "pendingUploads": {
      ".indexOn": [
        "createdAt"
      ]
    }
  }
}
